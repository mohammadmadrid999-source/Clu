<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Session keep-alive and its notification controls. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optional sound-click trigger only; requested at runtime when the user enables it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!--
      Deliberately NOT requested:
      - SYSTEM_ALERT_WINDOW: overlays use TYPE_ACCESSIBILITY_OVERLAY from the accessibility
        service (no extra permission, trusted for touch pass-through on Android 12+).
      - REQUEST_IGNORE_BATTERY_OPTIMIZATIONS: Doze does not apply while the screen is on, and the
        settings screen is opened via ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS instead.
      - HIGH_SAMPLING_RATE_SENSORS: 100 Hz is below the 200 Hz cap.
    -->

    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+ package visibility: resolve launchers so injection is blocked on the home screen. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".CluApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Clu"
        tools:targetApi="36">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Stand-in "game" for the on-device injection self-test; landscape like most games, so
          layout fractions match. Android 16 ignores the lock only on large screens (sw600dp+).
        -->
        <activity
            android:name=".ui.InjectionTestActivity"
            android:exported="false"
            android:label="@string/test_report_title"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi" />

        <service
            android:name=".input.InputDispatcherService"
            android:exported="true"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/input_dispatcher_service" />
        </service>

        <service
            android:name=".service.MotionSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Assistive input for people with motor disabilities: continuously converts device motion into touch input over other apps while a user-started session is active." />
        </service>
    </application>
</manifest>
