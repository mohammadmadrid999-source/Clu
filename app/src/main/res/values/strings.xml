    <string name="app_name">Clu</string>

    <!-- Accessibility service (shown in system Accessibility settings) -->
    <string name="a11y_service_label">Clu motion controls</string>
    <string name="a11y_service_summary">Play games by tilting or turning your phone or head</string>
    <string name="a11y_service_description">Clu turns small movements of your device into touches and joystick drags in games, for people who find touch screens hard to use. It needs to perform gestures on your behalf and to see which app is in front, so it can pause itself in Settings and on the home screen. It also listens for keys you choose, such as a switch interface or volume buttons. Clu does not read what is on your screen.</string>

